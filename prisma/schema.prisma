generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UsersAccounts {
  id             Int      @id @default(autoincrement())
  displayName    String
  email          String   @unique
  mobileNumber   String   @unique
  password       String
  role           Int
  company        Int?
  passwordOTP    Int?
  isActive       Boolean
  isDeleted      Boolean  @default(false)
  isFirstLogin   Boolean  @default(true)
  lastLogin      DateTime?
  refreshToken   String?  @db.VarChar(600)

  createdBy      Int?
  updatedBy      Int?
  deletedBy      Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime?
  deletedAt      DateTime?

  userRole     Roles              @relation("userRole", fields: [role], references: [id])
  userCompany  CompaniesAccounts? @relation("userCompany", fields: [company], references: [id])

  createdByUser UsersAccounts? @relation("userCreatedBy", fields: [createdBy], references: [id])
  updatedByUser UsersAccounts? @relation("userUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser UsersAccounts? @relation("userDeletedBy", fields: [deletedBy], references: [id])

  createdUsers UsersAccounts[] @relation("userCreatedBy")
  updatedUsers UsersAccounts[] @relation("userUpdatedBy")
  deletedUsers UsersAccounts[] @relation("userDeletedBy")

  createdFunctions  Functions[] @relation("userCreatedFunctions")
  updatedFunctions  Functions[] @relation("userUpdatedFunctions")
  deletedFunctions  Functions[] @relation("userDeletedFunctions")

  createdUserFunctions  UserFunctions[] @relation("userCreatedUserFunctions")
  updatedUserFunctions  UserFunctions[] @relation("userUpdatedUserFunctions")

  createdRoles   Roles[] @relation("userCreatedRoles")
  updatedRoles   Roles[] @relation("userUpdatedRoles")
  deletedRoles   Roles[] @relation("userDeletedRoles")

  createdCompanies  CompaniesAccounts[] @relation("userCreatedCompanies")
  updatedCompanies  CompaniesAccounts[] @relation("userUpdatedCompanies")
  deletedCompanies  CompaniesAccounts[] @relation("userDeletedCompanies")

  createdCompanyModules CompaniesModules[] @relation("userCreatedCompanyModules")
  deletedCompanyModules CompaniesModules[] @relation("userDeletedCompanyModules")

  userFunctions UserFunctions[]

  @@map("users_accounts")
}

model CompaniesAccounts {
  id             Int      @id @default(autoincrement())  
  displayName    String
  isActive       Boolean
  isDeleted      Boolean  @default(false)

  createdBy      Int?
  updatedBy      Int?
  deletedBy      Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime?
  deletedAt      DateTime?

  createdByUser UsersAccounts? @relation("userCreatedCompanies", fields: [createdBy], references: [id])
  updatedByUser UsersAccounts? @relation("userUpdatedCompanies", fields: [updatedBy], references: [id])
  deletedByUser UsersAccounts? @relation("userDeletedCompanies", fields: [deletedBy], references: [id])

  Roles          Roles[]
  UsersAccounts  UsersAccounts[] @relation("userCompany")
  CompaniesModules CompaniesModules[]

  @@map("companies_accounts")
}

model CompaniesModules {
  company  Int
  module   Int

  createdAt      DateTime @default(now())
  deletedAt      DateTime?

  Company  CompaniesAccounts? @relation(fields: [company], references: [id])
  Module   Functions?         @relation(fields: [module], references: [id])

  createdBy Int?
  deletedBy Int?

  createdByUser UsersAccounts? @relation("userCreatedCompanyModules", fields: [createdBy], references: [id])
  deletedByUser UsersAccounts? @relation("userDeletedCompanyModules", fields: [deletedBy], references: [id])

  @@id([company, module])
  @@map("companies_modules")
}

model Roles {
  id          Int      @id @default(autoincrement())
  displayName String
  isActive    Boolean
  company     Int?
  isDeleted   Boolean  @default(false)

  createdBy Int?
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  Company CompaniesAccounts? @relation(fields: [company], references: [id])

  createdByUser UsersAccounts? @relation("userCreatedRoles", fields: [createdBy], references: [id])
  updatedByUser UsersAccounts? @relation("userUpdatedRoles", fields: [updatedBy], references: [id])
  deletedByUser UsersAccounts? @relation("userDeletedRoles", fields: [deletedBy], references: [id])

  UsersAccounts  UsersAccounts[] @relation("userRole")

  @@map("roles")
}

model Functions {
  id          Int      @id @default(autoincrement())
  menuName    String
  displayName String
  icon        String
  parentMenu  String?
  isDeleted   Boolean  @default(false)

  createdBy Int?
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  createdByUser UsersAccounts? @relation("userCreatedFunctions", fields: [createdBy], references: [id])
  updatedByUser UsersAccounts? @relation("userUpdatedFunctions", fields: [updatedBy], references: [id])
  deletedByUser UsersAccounts? @relation("userDeletedFunctions", fields: [deletedBy], references: [id])

  UserFunctions   UserFunctions[]
  CompaniesModules CompaniesModules[]

  @@map("functions")
}

model UserFunctions {
  id        Int @id @default(autoincrement())
  user      Int
  function  Int

  createdBy Int?
  updatedBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime?

  User     UsersAccounts     @relation(fields: [user], references: [id])
  Function Functions @relation(fields: [function], references: [id])

  createdByUser UsersAccounts? @relation("userCreatedUserFunctions", fields: [createdBy], references: [id])
  updatedByUser UsersAccounts? @relation("userUpdatedUserFunctions", fields: [updatedBy], references: [id])

  @@unique([user, function])

  @@map("user_functions")
}
