generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UsersAccounts {
  id             Int      @id @default(autoincrement())
  displayName    String
  email          String   @unique
  mobileNumber   String   @unique
  password       String
  role           Int
  company        Int?
  passwordOTP    Int?
  isActive       Boolean
  isDeleted      Boolean  @default(false)
  isFirstLogin   Boolean  @default(true)
  lastLogin      DateTime?
  refreshToken   String?  @db.VarChar(600)

  createdBy      Int?
  updatedBy      Int?
  deletedBy      Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime?
  deletedAt      DateTime?

  // Direct relations
  roleRelation     Roles              @relation("userRole", fields: [role], references: [id])
  companyRelation  CompaniesAccounts? @relation("userCompany", fields: [company], references: [id])

  // Audit relations (incoming)
  createdByUser UsersAccounts? @relation("usersCreated", fields: [createdBy], references: [id])
  updatedByUser UsersAccounts? @relation("usersUpdated", fields: [updatedBy], references: [id])
  deletedByUser UsersAccounts? @relation("usersDeleted", fields: [deletedBy], references: [id])

  // Audit relations (outgoing)
  createdUsers UsersAccounts[] @relation("usersCreated")
  updatedUsers UsersAccounts[] @relation("usersUpdated")
  deletedUsers UsersAccounts[] @relation("usersDeleted")

  // Child audit mappings
  createdRoles        Roles[]              @relation("rolesCreated")
  updatedRoles        Roles[]              @relation("rolesUpdated")
  deletedRoles        Roles[]              @relation("rolesDeleted")

  createdCompanies    CompaniesAccounts[]  @relation("companiesCreated")
  updatedCompanies    CompaniesAccounts[]  @relation("companiesUpdated")
  deletedCompanies    CompaniesAccounts[]  @relation("companiesDeleted")

  createdFunctions    Functions[]          @relation("functionsCreated")
  updatedFunctions    Functions[]          @relation("functionsUpdated")
  deletedFunctions    Functions[]          @relation("functionsDeleted")

  createdCompanyModules CompaniesModules[] @relation("companyModulesCreated")
  deletedCompanyModules CompaniesModules[] @relation("companyModulesDeleted")

  createdUserFunctions UserFunctions[]     @relation("userFunctionsCreated")
  updatedUserFunctions UserFunctions[]     @relation("userFunctionsUpdated")

  createdTasks        Tasks[]              @relation("tasksCreated")
  updatedTasks        Tasks[]              @relation("tasksUpdated")
  deletedTasks        Tasks[]              @relation("tasksDeleted")

  createdTaskTemplates TaskTemplate[]       @relation("taskTemplatesCreated")
  updatedTaskTemplates TaskTemplate[]       @relation("taskTemplatesUpdated")
  deletedTaskTemplates TaskTemplate[]       @relation("taskTemplatesDeleted")

  createdTaskStatuses   TaskStatus[]        @relation("taskStatusesCreated")
  updatedTaskStatuses   TaskStatus[]        @relation("taskStatusesUpdated")
  deletedTaskStatuses   TaskStatus[]        @relation("taskStatusesDeleted")

  createdTemplateStatuses TaskTemplateStatus[] @relation("templateStatusesCreated")
  updatedTemplateStatuses TaskTemplateStatus[] @relation("templateStatusesUpdated")
  deletedTemplateStatuses TaskTemplateStatus[] @relation("templateStatusesDeleted")

  // Assignment
  assignedTasks      Tasks[] @relation("taskAssignee")

  userFunctions      UserFunctions[]

  @@map("users_accounts")
}

model CompaniesAccounts {
  id          Int      @id @default(autoincrement())  
  displayName String
  isActive    Boolean
  isDeleted   Boolean  @default(false)

  createdBy   Int?
  updatedBy   Int?
  deletedBy   Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime?
  deletedAt   DateTime?

  createdByUser UsersAccounts? @relation("companiesCreated", fields: [createdBy], references: [id])
  updatedByUser UsersAccounts? @relation("companiesUpdated", fields: [updatedBy], references: [id])
  deletedByUser UsersAccounts? @relation("companiesDeleted", fields: [deletedBy], references: [id])

  roles            Roles[]
  companiesModules CompaniesModules[]
  tasks            Tasks[] @relation("taskCompany")
  taskStatus       TaskStatus[] @relation("taskStatusCompany")

  usersAccounts    UsersAccounts[] @relation("userCompany")

  @@map("companies_accounts")
}

model CompaniesModules {
  company    Int
  module     Int

  createdBy  Int?
  deletedBy  Int?

  createdAt  DateTime @default(now())
  deletedAt  DateTime?

  Company    CompaniesAccounts? @relation(fields: [company], references: [id])
  Module     Functions?         @relation(fields: [module], references: [id])

  createdByUser UsersAccounts? @relation("companyModulesCreated", fields: [createdBy], references: [id])
  deletedByUser UsersAccounts? @relation("companyModulesDeleted", fields: [deletedBy], references: [id])

  @@id([company, module])
  @@map("companies_modules")
}

model Roles {
  id          Int      @id @default(autoincrement())
  displayName String
  isActive    Boolean
  company     Int?
  isDeleted   Boolean @default(false)

  createdBy   Int?
  updatedBy   Int?
  deletedBy   Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime?
  deletedAt   DateTime?

  Company     CompaniesAccounts? @relation(fields: [company], references: [id])

  createdByUser UsersAccounts? @relation("rolesCreated", fields: [createdBy], references: [id])
  updatedByUser UsersAccounts? @relation("rolesUpdated", fields: [updatedBy], references: [id])
  deletedByUser UsersAccounts? @relation("rolesDeleted", fields: [deletedBy], references: [id])

  usersAccounts UsersAccounts[] @relation("userRole")

  @@map("roles")
}

model Functions {
  id          Int      @id @default(autoincrement())
  menuName    String
  displayName String
  icon        String
  parentMenu  String?
  isDeleted   Boolean  @default(false)

  createdBy   Int?
  updatedBy   Int?
  deletedBy   Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime?
  deletedAt   DateTime?

  createdByUser UsersAccounts? @relation("functionsCreated", fields: [createdBy], references: [id])
  updatedByUser UsersAccounts? @relation("functionsUpdated", fields: [updatedBy], references: [id])
  deletedByUser UsersAccounts? @relation("functionsDeleted", fields: [deletedBy], references: [id])

  userFunctions     UserFunctions[]
  companiesModules  CompaniesModules[]

  @@map("functions")
}

model UserFunctions {
  id         Int @id @default(autoincrement())
  user       Int
  function   Int

  createdBy  Int?
  updatedBy  Int?

  createdAt  DateTime @default(now())
  updatedAt  DateTime?

  User       UsersAccounts @relation(fields: [user], references: [id])
  Function   Functions     @relation(fields: [function], references: [id])

  createdByUser UsersAccounts? @relation("userFunctionsCreated", fields: [createdBy], references: [id])
  updatedByUser UsersAccounts? @relation("userFunctionsUpdated", fields: [updatedBy], references: [id])

  @@unique([user, function])

  @@map("user_functions")
}

model TaskTemplate {
  id        Int      @id @default(autoincrement())
  name      String

  createdBy Int?
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  statuses  TaskTemplateStatus[]
  tasks     Tasks[] @relation("taskTemplate")

  createdByUser UsersAccounts? @relation("taskTemplatesCreated", fields: [createdBy], references: [id])
  updatedByUser UsersAccounts? @relation("taskTemplatesUpdated", fields: [updatedBy], references: [id])
  deletedByUser UsersAccounts? @relation("taskTemplatesDeleted", fields: [deletedBy], references: [id])

  @@map("tasks_templates")
}

model TaskStatus {
  id        Int      @id @default(autoincrement())
  name      String
  company   Int?
  isStart   Boolean
  isFinish  Boolean

  createdBy Int?
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  tasks Tasks[] @relation("taskStatus")

  companyRelation  CompaniesAccounts? @relation("taskStatusCompany", fields: [company], references: [id])

  createdByUser UsersAccounts? @relation("taskStatusesCreated", fields: [createdBy], references: [id])
  updatedByUser UsersAccounts? @relation("taskStatusesUpdated", fields: [updatedBy], references: [id])
  deletedByUser UsersAccounts? @relation("taskStatusesDeleted", fields: [deletedBy], references: [id])

  @@map("task_statuses")
}

model TaskTemplateStatus {
  id        Int    @id @default(autoincrement())
  template  Int
  name      String
  sequence  Int  

  createdBy Int?
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  taskTemplate TaskTemplate @relation(fields: [template], references: [id])

  createdByUser UsersAccounts? @relation("templateStatusesCreated", fields: [createdBy], references: [id])
  updatedByUser UsersAccounts? @relation("templateStatusesUpdated", fields: [updatedBy], references: [id])
  deletedByUser UsersAccounts? @relation("templateStatusesDeleted", fields: [deletedBy], references: [id])

  @@unique([template, sequence])
  @@map("task_template_status")
}

model Tasks {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.VarChar(600)
  dueDate     DateTime
  completedOn DateTime?
  assignee    Int
  company     Int?
  template    Int?
  status      Int?
  priority     String @default("low")
  actualExpenses Decimal?
  expectedExpenses Decimal?


  createdBy   Int?
  updatedBy   Int?
  deletedBy   Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime?
  deletedAt   DateTime?

  Assignee      UsersAccounts       @relation("taskAssignee", fields: [assignee], references: [id])
  taskCompany   CompaniesAccounts?  @relation("taskCompany", fields: [company], references: [id])
  taskTemplate  TaskTemplate?       @relation("taskTemplate", fields: [template], references: [id])
  taskStatus    TaskStatus?         @relation("taskStatus", fields: [status], references: [id])

  createdByUser UsersAccounts? @relation("tasksCreated", fields: [createdBy], references: [id])
  updatedByUser UsersAccounts? @relation("tasksUpdated", fields: [updatedBy], references: [id])
  deletedByUser UsersAccounts? @relation("tasksDeleted", fields: [deletedBy], references: [id])

  @@map("tasks")
}
